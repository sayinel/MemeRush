# Copy to .dev.vars for `wrangler dev`; in Cloudflare set the same names (secrets for keys). Values stay empty here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty: the email button stays on.
NEXT_PUBLIC_HIDE_EMAIL=
# Do NOT set LOCAL_PLAY / ADMIN_LOCAL / ADMIN_DEMO in production.
NEXT_PUBLIC_MVP_URL=
SITE_HOST=
# D1 (Cloudflare) is a binding named DB in wrangler.jsonc, not an env var. Remote setup: create the DB, put its id in wrangler.jsonc, run npm run d1:migrate:remote.
# HMAC secret for confirm/unsubscribe links and suppression hashes (set as a secret in Cloudflare; any long random string). Value stays empty here.
# Key rotation: add UNSUB_SECRET_V2 (secret) and set UNSUB_KEY_VERSION=2; links signed with version 1 keep working while UNSUB_SECRET stays set.
UNSUB_SECRET=
UNSUB_KEY_VERSION=
# Confirmation + welcome mail via Azure Communication Services Email. Send only when MAIL_ENABLED=1. Values stay empty here (ACS_ACCESS_KEY is a secret).
MAIL_ENABLED=
ACS_ENDPOINT=
ACS_ACCESS_KEY=
MAIL_SENDER=
